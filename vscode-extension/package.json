{
  "name": "llm-auto-confirm",
  "displayName": "LLM Auto Confirm",
  "description": "Auto-confirm permission prompts for LLM coding assistants (Claude Code, Aider, Goose, Codex) in VS Code terminals and WebView panels",
  "version": "0.6.6",
  "publisher": "sudoghut",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sudoghut/llm-auto-confirm"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "llm-auto-confirm.start",
        "title": "LLM Auto Confirm: Start"
      },
      {
        "command": "llm-auto-confirm.stop",
        "title": "LLM Auto Confirm: Stop"
      },
      {
        "command": "llm-auto-confirm.toggle",
        "title": "LLM Auto Confirm: Pause/Resume Auto-Confirm"
      },
      {
        "command": "llm-auto-confirm.toggleWebview",
        "title": "LLM Auto Confirm: Toggle WebView Mode"
      },
      {
        "command": "llm-auto-confirm.enableDebug",
        "title": "LLM Auto Confirm: Enable Debug Logging (currently OFF)"
      },
      {
        "command": "llm-auto-confirm.disableDebug",
        "title": "LLM Auto Confirm: Disable Debug Logging (currently ON)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "llm-auto-confirm.enableDebug",
          "when": "!llmAutoConfirm.debug"
        },
        {
          "command": "llm-auto-confirm.disableDebug",
          "when": "llmAutoConfirm.debug"
        }
      ]
    },
    "configuration": {
      "title": "LLM Auto Confirm",
      "properties": {
        "llmAutoConfirm.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable auto-confirmation on startup"
        },
        "llmAutoConfirm.debug": {
          "type": "boolean",
          "default": false,
          "description": "Enable verbose debug logging (raw terminal output, pattern match details, periodic tick logs) in the output channel"
        },
        "llmAutoConfirm.commandPatterns": {
          "type": "array",
          "default": [
            "claude",
            "aider",
            "goose",
            "codex"
          ],
          "items": {
            "type": "string"
          },
          "description": "Command name patterns to monitor in terminals (matched against the command line)"
        },
        "llmAutoConfirm.confirmResponse": {
          "type": "string",
          "default": "1",
          "description": "Fallback text to send when no prompt rule matches (e.g., '1' for Claude Code, 'y' for Aider)"
        },
        "llmAutoConfirm.cooldown": {
          "type": "number",
          "default": 1000,
          "minimum": 0,
          "maximum": 10000,
          "description": "Cooldown in milliseconds after confirming before checking again"
        },
        "llmAutoConfirm.promptPatterns": {
          "type": "array",
          "default": [
            "(?:Allow|Do you want).*(?:Yes|No)",
            "Save file to continue",
            "(?:[\\[\\(]\\s*y\\s*\\/\\s*n\\s*[\\]\\)]|\\(y\\)es|\\(n\\)o)"
          ],
          "items": {
            "type": "string"
          },
          "description": "Fallback regex patterns (used with confirmResponse when no promptRules match)"
        },
        "llmAutoConfirm.promptRules": {
          "type": "array",
          "default": [
            {
              "name": "Claude Code (numbered prompt)",
              "pattern": "(?:Allow|approve|Do you want|proceed\\?)[\\s\\S]*?\\d+\\s*\\.?\\s*Yes",
              "response": "1",
              "addNewline": "auto"
            },
            {
              "name": "Claude Code (save file prompt)",
              "pattern": "Save file to continue[\\s\\S]*?\\d+\\s*\\.?\\s*Yes",
              "response": "1",
              "addNewline": "auto"
            },
            {
              "name": "Claude Code (interactive list cursor)",
              "pattern": "(?:\\u276F|\\u203A|>)\\s*\\d+\\s*\\.?",
              "response": "",
              "addNewline": true
            },
            {
              "name": "Codex (selection list)",
              "pattern": "Allow command\\?",
              "response": "",
              "addNewline": true
            },
            {
              "name": "Y/n prompt (Aider, etc.)",
              "pattern": "(?:[\\[\\(]\\s*y\\s*\\/\\s*n\\s*[\\]\\)]|\\(y\\)es|\\(n\\)o)",
              "response": "y",
              "addNewline": true
            }
          ],
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Human-readable name for this rule"
              },
              "pattern": {
                "type": "string",
                "description": "Regex pattern to match in terminal output (flags: i, s)"
              },
              "response": {
                "type": "string",
                "description": "Text to send when this pattern matches (e.g., '1', 'y', or '' for just Enter)"
              },
              "addNewline": {
                "oneOf": [
                  { "type": "boolean" },
                  { "type": "string", "enum": ["auto"] }
                ],
                "description": "Whether to append a newline (Enter) after the response. Use \"auto\" to auto-detect interactive list prompts (❯ cursor → Enter only) vs non-interactive (response + Enter)."
              }
            },
            "required": ["name", "pattern", "response", "addNewline"]
          },
          "description": "Rules for detecting and responding to permission prompts. Each rule has a regex pattern and the specific response to send. Rules are checked in order; first match wins."
        },
        "llmAutoConfirm.dangerousCommandPatterns": {
          "type": "array",
          "default": [
            "rm -rf /",
            "rm -rf ~",
            "format c:",
            ":(){ :|:& };:",
            "dd if=/dev/zero",
            "> /dev/sda",
            "mkfs\\."
          ],
          "items": {
            "type": "string"
          },
          "description": "Regex patterns for dangerous commands that should NOT be auto-approved"
        },
        "llmAutoConfirm.webviewAutoConfirm": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "**Experimental.** Enable command-based auto-confirm for WebView LLM extensions (e.g., Claude Code, Cline). This calls known approval commands via the VS Code API — no OS-level keystroke simulation."
        },
        "llmAutoConfirm.webviewPollInterval": {
          "type": "number",
          "default": 3000,
          "minimum": 1000,
          "maximum": 30000,
          "description": "How often (ms) to attempt executing the approval command in WebView mode"
        },
        "llmAutoConfirm.webviewApprovalCommands": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Human-readable name (e.g., 'My Custom Extension')"
              },
              "command": {
                "type": "string",
                "description": "VS Code command ID to execute (e.g., 'myext.approve')"
              }
            },
            "required": ["name", "command"]
          },
          "markdownDescription": "Additional VS Code commands to try for WebView auto-confirm. Built-in commands for Kilo Code, Claude Code (diff only), Cline, and Roo Code are always included. User entries are checked first."
        }
      }
    }
  },
  "scripts": {
    "compile": "npm run bundle",
    "bundle": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "watch": "npm run bundle -- --watch",
    "package": "npm run bundle && vsce package",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.93.0",
    "esbuild": "^0.27.3",
    "typescript": "^5.3.0"
  }
}
