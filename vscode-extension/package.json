{
  "name": "llm-auto-confirm",
  "displayName": "LLM Auto Confirm",
  "description": "Auto-confirm permission prompts for LLM coding assistants (Claude Code, Aider, Goose, etc.) running in the VS Code terminal",
  "version": "0.2.0",
  "publisher": "sudoghut",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sudoghut/llm-auto-confirm"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "llm-auto-confirm.start",
        "title": "LLM Auto Confirm: Start"
      },
      {
        "command": "llm-auto-confirm.stop",
        "title": "LLM Auto Confirm: Stop"
      },
      {
        "command": "llm-auto-confirm.toggle",
        "title": "LLM Auto Confirm: Toggle"
      }
    ],
    "configuration": {
      "title": "LLM Auto Confirm",
      "properties": {
        "llmAutoConfirm.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable auto-confirmation on startup"
        },
        "llmAutoConfirm.commandPatterns": {
          "type": "array",
          "default": [
            "claude",
            "aider",
            "goose",
            "codex"
          ],
          "items": {
            "type": "string"
          },
          "description": "Command name patterns to monitor in terminals (matched against the command line)"
        },
        "llmAutoConfirm.confirmResponse": {
          "type": "string",
          "default": "y",
          "description": "Text to send to confirm a permission prompt (e.g., 'y' or '1')"
        },
        "llmAutoConfirm.cooldown": {
          "type": "number",
          "default": 1000,
          "minimum": 0,
          "maximum": 10000,
          "description": "Cooldown in milliseconds after confirming before checking again"
        },
        "llmAutoConfirm.promptPatterns": {
          "type": "array",
          "default": [
            "Allow.*(?:Yes|No)",
            "Do you want to (?:proceed|continue|allow|run).*\\?",
            "(?:Y\\/?n|y\\/N|\\(y\\)es|\\(n\\)o)"
          ],
          "items": {
            "type": "string"
          },
          "description": "Regex patterns to identify permission prompts in terminal output"
        },
        "llmAutoConfirm.dangerousCommandPatterns": {
          "type": "array",
          "default": [
            "rm -rf /",
            "rm -rf ~",
            "format c:",
            ":(){ :|:& };:",
            "dd if=/dev/zero",
            "> /dev/sda",
            "mkfs\\."
          ],
          "items": {
            "type": "string"
          },
          "description": "Regex patterns for dangerous commands that should NOT be auto-approved"
        }
      }
    }
  },
  "scripts": {
    "compile": "npm run bundle",
    "bundle": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "watch": "npm run bundle -- --watch",
    "package": "npm run bundle && vsce package",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.93.0",
    "esbuild": "^0.27.3",
    "typescript": "^5.3.0"
  }
}
